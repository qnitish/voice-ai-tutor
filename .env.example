# Gnani (TTS / STT)
GNANI_API_KEY=

# Sarvam (STT / TTS / voice cloning); a voice cloned with Sarvam is always spoken through it, see app/voices.py
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Speech providers: gnani | sarvam (see backend/app/providers/__init__.py)
STT_PROVIDER=gnani
TTS_PROVIDER=gnani
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani
# Gender of the default voice (female|male); cloned voices carry their own, see app/voices.py
TUTOR_GENDER=female
GNANI_TTS_LANGUAGE=hi-en
GNANI_STT_LANGUAGE=hi-IN

# Postgres from docker-compose.yml
DATABASE_URL=postgresql+psycopg://tutor:tutor@localhost:5440/voice_tutor
# Optional: a faster deployment just for doubt routing (defaults to AZURE_OPENAI_DEPLOYMENT)
AZURE_OPENAI_ROUTING_DEPLOYMENT=
# Offline prep model (outline, scenes, review, remedy). A reasoning model (e.g. o4-mini, gpt-5-mini) is much better
# at subject correctness; set the effort only for reasoning models. Reasoning needs AZURE_OPENAI_API_VERSION >= 2024-12-01-preview.
AZURE_OPENAI_PREP_DEPLOYMENT=
AZURE_OPENAI_PREP_REASONING_EFFORT=
