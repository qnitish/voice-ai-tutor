# Gnani (TTS / STT)
GNANI_API_KEY=

# Sarvam (STT / TTS / voice cloning); a voice cloned with Sarvam is always spoken through it, see app/voices.py
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh

# LLM: anthropic | azure | openai | deepseek | gemini (see backend/app/providers/__init__.py)
LLM_PROVIDER=anthropic
# Model for live answers, recaps and summaries; LLM_EFFORT is Claude's effort, or reasoning_effort for an
# OpenAI-style reasoning model (leave it empty for gpt-4o: non-reasoning models take a temperature instead)
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
# Optional: a faster model just for doubt routing (defaults to LLM_MODEL)
LLM_ROUTING_MODEL=claude-haiku-5-5
# Offline prep (outline, scenes, checkpoints, review, remedy): the strongest model, at high effort
LLM_PREP_MODEL=claude-opus-5-5
LLM_PREP_EFFORT=high
# One key per vendor; only the selected provider's is needed
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
# Azure OpenAI (LLM_PROVIDER=azure; LLM_MODEL is then the deployment name). Reasoning models need API version >= 2024-12-01-preview.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Speech providers: gnani | sarvam (see backend/app/providers/__init__.py)
STT_PROVIDER=gnani
TTS_PROVIDER=gnani
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani
# Gender of the default voice (female|male); cloned voices carry their own, see app/voices.py
TUTOR_GENDER=female
GNANI_TTS_LANGUAGE=hi-en
GNANI_STT_LANGUAGE=hi-IN

# Video doubt answers: textbook pages rendered with `python -m app.prep.book` are sent as images (true|false)
CONTEXT_BOOK_PAGES=true

# Postgres from docker-compose.yml
DATABASE_URL=postgresql+psycopg://tutor:tutor@localhost:5440/voice_tutor
